+// ------------------------------------------------------------------ decode
+// decode90_kernel: decode_kernel's program for Hopper, with the K / V tiles fed by TMA and the group's work
+// in two phases. Measured on H100 and L4: decode_kernel's time is its K / V copies. A 512-key fold group is
+// 262 KB that one CTA's threads copy as 16 K 16-byte cp.async, about 19 GB/s per SM whatever else the kernel
+// does (with the copies removed the kernel takes half the time; with every mma removed, the same time). Here
+// one thread issues two TMA boxes per page (16 keys x 64 head dims, 128-byte swizzled), a few tiles ahead.
+// With the loads off the critical path the group runs as
+//   A. S = Q K^T of every tile (each element's head_dim k-steps in ascending order; a tile's S depends on
+//      nothing of the other tiles) and the tile row maxima;
+//   B. per lane, in tile order: m' (an exact prefix maximum), sigma = 2^(m - m'), P = bf16(2^(s - m')), with
+//      decode_kernel's operations;
+//   C. the serial chain, tile by tile: warp 0 forms sum P in online_step's order and d = fma(d, sigma, sum P);
+//      every warp runs o = fma(o, sigma, +0) and the two key k-steps of P V on its O n-tiles.
+// Every element's operation sequence is decode_kernel's (same mma.sync instruction, same split of the tile
+// across the 4 warps); group partials, arrival counters and the fold are its code. A request's last page may
+// hold stale slots past kv_len: K's are masked as before, V's rows are zeroed after the load (decode_kernel
+// zero-fills them in the copy).
+// Needs page_size in {8, 16, 32} (whole pages per 32-key tile, at most 256 box elements).
+struct Decode90Tma {
+  cute::TmaDescriptor k, v;  // [pages][page_size][kv heads][128] bf16, box 64 dims x 1 head x page_size slots x 1 page
+};
+constexpr int kDec90Slots = 4;                           // K / V ring: loads issued kDec90Slots - 1 tiles ahead
+constexpr int kDec90Slot = kTile * kHeadDim;             // bf16 elements of a tile: [half][key][64]
+inline bool decode90_runs(int cc_major, int cc_minor, int page_size) {
+  return prefill_wgmma(cc_major, cc_minor) && (page_size == 8 || page_size == 16 || page_size == 32);
+}
+constexpr int decode90_smem_bytes(int group) {
+  return 2 * kDec90Slots * kDec90Slot * 2 + 2 * kDec90Slots * 8 + kGroupTiles * kDecodeWarps * 16 * 4 +
+         kGroupTiles * group * (kTile + 8) * 2;
+}
+// Element offset in a tile slot of 16-byte chunk `chunk` (8 head dims) of key `key`, as TMA's 128-byte swizzle
+// places it (slots are 1024-byte aligned).
+__device__ __forceinline__ int dec90_off(int key, int chunk) {
+  return (chunk >> 3) * (kTile * 64) + key * 64 + (((chunk & 7) ^ (key & 7)) << 3);
+}
+// Host: the two descriptors of a launch. max_pages bounds the page index (it only clips out-of-range boxes).
+inline bool decode90_descriptors(Decode90Tma* tma, const void* k_cache, const void* v_cache, int num_kv_heads,
+                                 int page_size) {
+  const cuuint64_t gdim[4] = {kHeadDim, (cuuint64_t)num_kv_heads, (cuuint64_t)page_size, (cuuint64_t)1 << 24};
+  const cuuint64_t gstride[3] = {kHeadDim * 2, (cuuint64_t)num_kv_heads * kHeadDim * 2,
+                                 (cuuint64_t)page_size * num_kv_heads * kHeadDim * 2};
+  const cuuint32_t box[4] = {64, 1, (cuuint32_t)page_size, 1}, estride[4] = {1, 1, 1, 1};
+  for (int c = 0; c < 2; ++c)
+    if (cuTensorMapEncodeTiled(c ? &tma->v : &tma->k, CU_TENSOR_MAP_DATA_TYPE_UINT16, 4,
+                               const_cast<void*>(c ? v_cache : k_cache), gdim, gstride, box, estride,
+                               CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                               CU_TENSOR_MAP_L2_PROMOTION_L2_128B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE) != CUDA_SUCCESS)
+      return false;
+  return true;
+}

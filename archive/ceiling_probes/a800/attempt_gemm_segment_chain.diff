+// ---------------------------------------------------- segment chain, M <= 8 ----
+// The same decode GEMMs, for GPUs where one warp walking a whole segment is slow: a
+// warp's instruction stream, not the DRAM stream, bounds the segment-split kernel on
+// the A800 (1.41 GHz; 0.6B o at M = 1: 8.4 us, cuBLAS 6.1). A CTA still owns one n8
+// tile; each segment's chain is cut into PIECE-column pieces, one warp per piece. Every
+// warp loads all of its A and B fragments straight from global memory into registers
+// (the mma.m16n8k16 layouts that ldmatrix gives the other kernels: row lane / 4,
+// columns 2 (lane % 4) and + 8), so the whole tile is in flight at once. The chain then
+// runs piece by piece in ascending k: warp j continues from the accumulator warp j - 1
+// left in shared memory, exactly as stream-K hands on a chain. Warp 0 folds the
+// segment partials as gemm_segsplit_kernel does. Rows >= M (and the fragment's rows
+// 8..15) are zero. S = 1 shapes run too: one chain per tile, written unfolded.
+template <typename OutT, int PIECE>
+__global__ void gemm_segchain_kernel(const __nv_bfloat16* __restrict__ x, int64_t ldx,
+                                     const __nv_bfloat16* __restrict__ w, OutT* __restrict__ y,
+                                     int64_t ldy, int M, int N, int K) {
+  constexpr int kSteps = PIECE / 16;
+  __shared__ float hand[kSegMax][32 * 4];
+  const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+  const int segs = gemm_segments(N, K), pieces = K / segs / PIECE, sg = warp / pieces, j = warp % pieces;
+  const int n0 = blockIdx.x * 8, k0 = sg * (K / segs) + j * PIECE + 2 * t;
+  const uint32_t* wr = reinterpret_cast<const uint32_t*>(w + (int64_t)(n0 + g) * K + k0);
+  const uint32_t* xr = reinterpret_cast<const uint32_t*>(x + (int64_t)g * ldx + k0);
+  uint32_t a[kSteps][2], b[kSteps][2];
+#pragma unroll
+  for (int s = 0; s < kSteps; ++s) {
+    b[s][0] = __ldg(wr + s * 8);
+    b[s][1] = __ldg(wr + s * 8 + 4);
+    a[s][0] = g < M ? __ldg(xr + s * 8) : 0u;
+    a[s][1] = g < M ? __ldg(xr + s * 8 + 4) : 0u;
+  }
+  float acc[4] = {0.f, 0.f, 0.f, 0.f};
+  for (int p = 0; p < pieces; ++p) {
+    if (j == p) {
+      if (p) {
+#pragma unroll
+        for (int i = 0; i < 4; ++i) acc[i] = hand[sg][lane * 4 + i];
+      }
+#pragma unroll
+      for (int s = 0; s < kSteps; ++s) {
+        const uint32_t af[4] = {a[s][0], 0u, a[s][1], 0u};
+        mma_bf16(acc, af, b[s][0], b[s][1]);
+      }
+#pragma unroll
+      for (int i = 0; i < 4; ++i) hand[sg][lane * 4 + i] = acc[i];
+    }
+    __syncthreads();
+  }
+  if (warp) return;
+  float tot[2] = {hand[0][lane * 4], hand[0][lane * 4 + 1]};
+  if (segs > 1) {  // ((+0 + p_0) + p_1) + ...; with S = 1 the chain's value itself
+    tot[0] = tot[1] = 0.f;
+    for (int s = 0; s < segs; ++s) {
+      tot[0] = add(tot[0], hand[s][lane * 4]);
+      tot[1] = add(tot[1], hand[s][lane * 4 + 1]);
+    }
+  }
+  if (g >= M) return;
+  const int n = n0 + 2 * t;
+  if constexpr (sizeof(OutT) == 2) {
+    *reinterpret_cast<__nv_bfloat162*>(y + (int64_t)g * ldy + n) = __floats2bfloat162_rn(tot[0], tot[1]);
+  } else {
+    *reinterpret_cast<float2*>(y + (int64_t)g * ldy + n) = make_float2(tot[0], tot[1]);
+  }
+}

+
+// ---------------------------------------------------------------------------------------------------------
+// Decode on Hopper: decode_kernel's program for one fold group on 20 warps instead of 4.
+//
+// decode_kernel is bound by what one warp executes in sequence (archive/ceiling_probes/h100_decode_cluster):
+// with one K and one V tile in flight a tile costs two load latencies (0.85 us, from DRAM or L2 alike), and
+// with a group's tiles in flight its 4 warps still take 0.37 us per tile for S, 0.13 for P and 0.22 for the o
+// step. The contract serialises little of a group: S of a key depends on that key only, the running max is a
+// prefix max of exact tile maxima, scale_t and P_t are elementwise functions of S and the max, the row sums
+// of P_t are independent per tile, and only d_t and o_t are chains, o_t independently per head dim. So here
+//   - 16 warps issue the group's K and V in three cp.async groups (K of the 16 tiles; V of 8; V of the other 8
+//     into K slots once S is done) and wait three times;
+//   - 4 tiles of S run at once (warp 4 a + n: tiles = a mod 4, S n-tile n, decode_kernel's mma sequence);
+//     4 more warps form the exact tile maxima and one of them the running max and the scales, then the 16
+//     form P of their own tiles;
+//   - the o chain runs on decode_kernel's 4 warps: per tile fma rescale, then the two key k-steps. A tile whose
+//     scale is 1 on every row of the warp skips the rescale: fma(o, 1, +0) == o, as o never holds -0;
+//   - meanwhile the 4 other warps form the row sums of P in online_step's order, and one of them the d chain.
+// An SM retires about one warp instruction per cycle whatever the number of warps, so the kernel's time is
+// its instruction count; the warps only keep the SM fed across load and dependency latencies.
+// Every element runs decode_kernel's instruction sequence on the same operands: the same bits. The group
+// partial, the arrival counters and the fold are decode_kernel's, per 32-dim quarter of the head.
+constexpr int kD90Warps = 20, kD90SWarps = 16;  // warps 16-19: tile maxima, row sums, the d chain
+constexpr int decode90_smem_bytes() {
+  return 24 * kTile * kHeadDim * 2                    // 16 K and 8 V tile slots
+         + kGroupTiles * 16 * (kTile + 8) * 2         // P of every tile
+         + kGroupTiles * (kDecodeWarps + 4) * 16 * 4  // per tile: maxima per S n-tile, max, m, scale, row sum of P
+         + 2 * 16 * 4;                                // d and m of the group
+}
+
+__global__ void __launch_bounds__(kD90Warps * 32)
+    decode90_kernel(const __nv_bfloat16* __restrict__ q, const __nv_bfloat16* __restrict__ k_cache,
+                    const __nv_bfloat16* __restrict__ v_cache, const int32_t* __restrict__ kv_page_indptr,
+                    const int32_t* __restrict__ kv_page_indices, int64_t table_stride,
+                    const int32_t* __restrict__ kv_lens, float* __restrict__ ws_o, float2* __restrict__ ws_ml,
+                    int* __restrict__ counters, __nv_bfloat16* __restrict__ out, int max_groups,
+                    int num_qo_heads, int num_kv_heads, int page_size, int page_shift, float scale_log2,
+                    bool group_fastest) {
+  static_assert(kTileNS == 4 && kGroupTiles == 16 && kDecodeWarps == 4 && kNTilesO % kDecodeWarps == 0,
+                "4 S n-tiles per tile, 4 tiles at once, decode_kernel's o warps");
+  constexpr int kON = kNTilesO / kDecodeWarps;
+  constexpr int kPStride = kTile + 8, kPTile = 16 * kPStride, kTileElems = kTile * kHeadDim;
+  extern __shared__ __align__(16) __nv_bfloat16 smem[];
+  __nv_bfloat16* sKV = smem;                             // [24][kTile][128], swz per tile: K(lt) in slot lt,
+                                                         // V(lt) in slot 16 + lt (lt < 8) or lt - 8
+  __nv_bfloat16* sP = sKV + 24 * kTileElems;             // [16 tiles][16 rows][kPStride]
+  float* sMax = reinterpret_cast<float*>(sP + kGroupTiles * kPTile);  // [16 tiles][4 n-tiles][16 rows]
+  float* sTMax = sMax + kGroupTiles * 4 * 16;            // [16 tiles][16 rows] tile max
+  float* sMM = sTMax + kGroupTiles * 16;                 // ... running max after the tile (0 if -inf)
+  float* sScale = sMM + kGroupTiles * 16;                // ... scale
+  float* sLS = sScale + kGroupTiles * 16;                // ... row sum of P
+  float* sL = sLS + kGroupTiles * 16;                    // [16 rows] d of the group
+  float* sMF = sL + 16;                                  // [16 rows] m of the group
+  const int kvh = group_fastest ? blockIdx.y : blockIdx.x, b = group_fastest ? 0 : blockIdx.y;
+  const int fg = group_fastest ? blockIdx.x : blockIdx.z;
+  const int kv_len = kv_lens[b], pos = kv_len - 1;
+  const int n_tiles = (kv_len + kTile - 1) / kTile;
+  const int t_begin = fg * kGroupTiles;
+  if (t_begin >= n_tiles) return;
+  const int nt = min(n_tiles - t_begin, kGroupTiles);  // tiles of this group
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const int g = lane >> 2, t4 = lane & 3, mat = lane >> 3, r8 = lane & 7;
+  const int set = warp >> 2, wi = warp & 3;  // S / copies: tiles = set mod 4, S n-tile wi; set 4: row sums
+  const bool sw = warp < kD90SWarps, ow = warp < kDecodeWarps;
+  const int ctid = tid & 127;                // issue_tile's thread index within the set
+  const int group = num_qo_heads / num_kv_heads;
+  const int32_t* pages = request_pages(kv_page_indices, kv_page_indptr, table_stride, b);
+  auto row_of = [&](int lt) {
+    return tile_row(pages, page_size, page_shift, t_begin + lt, kv_len, num_kv_heads, kvh, ctid);
+  };
+  auto v_slot = [&](int lt) { return sKV + (lt < 8 ? 16 + lt : lt - 8) * kTileElems; };
+
+  // Loads, group 1: K of the warp set's 4 tiles. Group 2: V of tiles 0-7.
+  QFrag qf;
+  int64_t rows[4];
+  if (sw) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int lt = set + 4 * i;
+      rows[i] = lt < nt ? row_of(lt) : -1;
+      if (lt < nt) issue_tile(sKV + lt * kTileElems, k_cache, rows[i], ctid);
+    }
+  }
+  cp_async_commit();
+  if (sw) {
+#pragma unroll
+    for (int i = 0; i < 2; ++i) {
+      const int lt = set + 4 * i;
+      if (lt < nt) issue_tile(v_slot(lt), v_cache, rows[i], ctid);
+    }
+    const int64_t q_stride = (int64_t)num_qo_heads * kHeadDim;
+    load_q(qf, [&](int r) -> const __nv_bfloat16* {
+             return r < group ? q + b * q_stride + (kvh * group + r) * kHeadDim : nullptr;
+           }, lane);
+  }
+  cp_async_commit();
+
+  // S of the warp's 4 tiles (tiles set + 4 i), their mma chains interleaved; the warp's maxima of its 8 keys.
+  float s[4][4];
+  cp_async_wait<1>();  // group 1
+  __syncthreads();
+  if (sw) {
+#pragma unroll
+    for (int i = 0; i < 4; ++i) s[i][0] = s[i][1] = s[i][2] = s[i][3] = 0.f;
+#pragma unroll
+    for (int ks = 0; ks < kKStepsQK; ++ks)
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const int lt = set + 4 * i;
+        if (lt < nt) {
+          uint32_t bk[4];
+          ldmatrix_x4(bk, sKV + lt * kTileElems + swz(wi * 8 + r8, ks * 2 + (mat & 1)));
+          mma_bf16(s[i], qf.a[ks], bk[0], bk[1]);
+        }
+      }
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int lt = set + 4 * i;
+      if (lt < nt) {
+        float mx[2] = {-INFINITY, -INFINITY};
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+          const int row = g + (e >> 1) * 8, key = (t_begin + lt) * kTile + wi * 8 + t4 * 2 + (e & 1);
+          s[i][e] = (row < group && key <= pos) ? mul(s[i][e], scale_log2) : -INFINITY;
+          mx[e >> 1] = fmaxf(mx[e >> 1], s[i][e]);
+        }
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+          mx[r] = fmaxf(mx[r], __shfl_xor_sync(0xffffffffu, mx[r], 1));
+          mx[r] = fmaxf(mx[r], __shfl_xor_sync(0xffffffffu, mx[r], 2));
+        }
+        if (t4 == 0) {
+          sMax[(lt * 4 + wi) * 16 + g] = mx[0];
+          sMax[(lt * 4 + wi) * 16 + g + 8] = mx[1];
+        }
+      }
+    }
+  }
+  __syncthreads();  // maxima published; all warps done with K: slots 0-7 take V of tiles 8-15 (group 3)
+  if (sw) {
+#pragma unroll
+    for (int i = 2; i < 4; ++i) {
+      const int lt = set + 4 * i;
+      if (lt < nt) issue_tile(v_slot(lt), v_cache, rows[i], ctid);
+    }
+  }
+  cp_async_commit();
+  if (!sw && t4 == 0) {  // exact tile maxima: warp 16 + a takes the tiles = a mod 4
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int lt = wi + 4 * i;
+      if (lt < nt) {
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+          float tmax = -INFINITY;
+#pragma unroll
+          for (int n = 0; n < 4; ++n) tmax = fmaxf(tmax, sMax[(lt * 4 + n) * 16 + g + r * 8]);
+          sTMax[lt * 16 + g + r * 8] = tmax;
+        }
+      }
+    }
+  }
+  __syncthreads();
+  if (warp == kD90SWarps && t4 == 0) {  // the running max and the scale of every tile, the group's m
+    float M[2] = {-INFINITY, -INFINITY};
+    for (int lt = 0; lt < nt; ++lt)
+#pragma unroll
+      for (int r = 0; r < 2; ++r) {
+        const float mn = fmaxf(M[r], sTMax[lt * 16 + g + r * 8]);
+        const float mm = mn == -INFINITY ? 0.f : mn;
+        sMM[lt * 16 + g + r * 8] = mm;
+        sScale[lt * 16 + g + r * 8] = ex2(sub(M[r], mm));
+        M[r] = mn;
+      }
+    sMF[g] = M[0], sMF[g + 8] = M[1];
+  }
+  __syncthreads();
+  if (sw) {  // P of the warp's own tiles, as decode_kernel forms it (rows >= group: m = -inf, P = +0)
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const int lt = set + 4 * i;
+      if (lt < nt) {
+        const float mm[2] = {sMM[lt * 16 + g], sMM[lt * 16 + g + 8]};
+        float p[4];  // rounded to bf16 by the pack below: the bits decode_kernel stores
+#pragma unroll
+        for (int e = 0; e < 4; ++e) p[e] = ex2(sub(s[i][e], mm[e >> 1]));
+        const int key = wi * 8 + t4 * 2;
+        *reinterpret_cast<uint32_t*>(sP + lt * kPTile + g * kPStride + key) = pack_bf16(p[0], p[1]);
+        *reinterpret_cast<uint32_t*>(sP + lt * kPTile + (g + 8) * kPStride + key) = pack_bf16(p[2], p[3]);
+      }
+    }
+  }
+  cp_async_wait<1>();  // group 2
+  __syncthreads();     // ... for all threads; P published
+
+  // The o step of tile lt on this warp's O n-tiles: decode_kernel's fma rescale and two key k-steps. P comes
+  // as A fragments through ldmatrix (the registers decode_kernel loads word by word).
+  float O[kON][4];
+#pragma unroll
+  for (int n = 0; n < kON; ++n) O[n][0] = O[n][1] = O[n][2] = O[n][3] = 0.f;
+  auto pv = [&](int lt) {
+    if (lt < nt) {
+      const float scale[2] = {sScale[lt * 16 + g], sScale[lt * 16 + g + 8]};
+      if (__any_sync(0xffffffffu, (g < group && scale[0] != 1.f) || (g + 8 < group && scale[1] != 1.f))) {
+#pragma unroll
+        for (int n = 0; n < kON; ++n)
+#pragma unroll
+          for (int e = 0; e < 4; ++e) O[n][e] = __fmaf_rn(O[n][e], scale[e >> 1], 0.f);
+      }
+      const __nv_bfloat16* pt = sP + lt * kPTile + ((mat & 1) * 8 + r8) * kPStride + (mat >> 1) * 8;
+      const __nv_bfloat16* vt = v_slot(lt);
+#pragma unroll
+      for (int j = 0; j < kTileKS; ++j) {
+        uint32_t pa[4];
+        ldmatrix_x4(pa, pt + j * 16);
+#pragma unroll
+        for (int n = 0; n < kON; n += 2) {
+          uint32_t bv[4];
+          ldmatrix_x4_trans(bv, vt + swz(j * 16 + (mat & 1) * 8 + r8, warp * kON + n + (mat >> 1)));
+          mma_bf16(O[n], pa, bv[0], bv[1]);
+          mma_bf16(O[n + 1], pa, bv[2], bv[3]);
+        }
+      }
+    }
+  };
+  // Row sums of P of tile lt in exactly online_step's order (own keys n = 0.., then lane xor 1, xor 2).
+  auto row_sums = [&](int lt) {
+    if (lt < nt) {
+      const __nv_bfloat16* pt = sP + lt * kPTile;
+      float ls[2] = {0.f, 0.f};
+#pragma unroll
+      for (int n = 0; n < kTileNS; ++n) {
+        const __nv_bfloat162 p0 = *reinterpret_cast<const __nv_bfloat162*>(pt + g * kPStride + n * 8 + t4 * 2);
+        const __nv_bfloat162 p1 = *reinterpret_cast<const __nv_bfloat162*>(pt + (g + 8) * kPStride + n * 8 + t4 * 2);
+        ls[0] = add(ls[0], __low2float(p0));
+        ls[0] = add(ls[0], __high2float(p0));
+        ls[1] = add(ls[1], __low2float(p1));
+        ls[1] = add(ls[1], __high2float(p1));
+      }
+#pragma unroll
+      for (int r = 0; r < 2; ++r) {
+        ls[r] = add(ls[r], __shfl_xor_sync(0xffffffffu, ls[r], 1));
+        ls[r] = add(ls[r], __shfl_xor_sync(0xffffffffu, ls[r], 2));
+      }
+      if (t4 == 0) {
+        sLS[lt * 16 + g] = ls[0];
+        sLS[lt * 16 + g + 8] = ls[1];
+      }
+    }

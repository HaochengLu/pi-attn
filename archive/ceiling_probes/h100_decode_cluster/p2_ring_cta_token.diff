+        pa[j][1] = *reinterpret_cast<const uint32_t*>(pt + (g + 8) * kPStride + k0);
+        pa[j][2] = *reinterpret_cast<const uint32_t*>(pt + g * kPStride + k0 + 8);
+        pa[j][3] = *reinterpret_cast<const uint32_t*>(pt + (g + 8) * kPStride + k0 + 8);

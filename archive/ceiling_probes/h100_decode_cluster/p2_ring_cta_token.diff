+// ---------------------------------------------------------------------------------------------------------
+// Decode on Hopper: one fold group on a thread-block cluster of N CTAs (N = 2, 4, 8, 16) on different SMs.
+//
+// decode_kernel streams a group's 256 KB of K and V through one CTA, which is its whole time at small batch:
+// a CTA takes in about 100 cache lines per microsecond whatever is in flight (archive/ceiling_probes/
+// h100_decode, h100_decode_cluster). The contract serialises very little of a group: S of a key depends on
+// that key only, the running max m_t is a prefix max of exact tile maxima, scale_t and P_t are elementwise
+// functions of S and m_t, and only d_t = fma(d_(t-1), scale_t, sum P_t) and o_t = fma(o_(t-1), scale_t, +0)
+// + P_t V_t are chains. So CTA c of the cluster owns the key tiles [c T, (c + 1) T) of the group, T = 16 / N:
+//   1. it issues the K and V of its tiles at once and computes their S (decode_kernel's mma sequence); each
+//      warp writes its exact maxima to the CTAs that own later tiles (distributed shared memory), and one
+//      cluster barrier, taken while V is still landing, publishes them;
+//   2. it forms the prefix max, the scales and P of its tiles, as decode_kernel does;
+//   3. it receives (d, o) from CTA c - 1 through its shared memory (an mbarrier signals the hand-off), runs
+//      decode_kernel's d and o steps over its tiles in ascending order, and hands (d, o) to CTA c + 1.
+// The CTA of the group's last tile then writes the output or the group partial exactly as decode_kernel
+// does. Every element runs decode_kernel's instruction sequence on the same operands: the same bits.
+template <int N>
+constexpr int decode90_smem_bytes() {
+  return 2 * (kGroupKeys / N) * kHeadDim * 2                // K and V of the CTA's tiles
+         + (kGroupTiles / N) * 16 * (kTile + 8) * 2          // P of its tiles
+         + kGroupTiles * kDecodeWarps * 16 * 4               // per-warp maxima of every tile
+         + 16 * kHeadDim * 4 + 16 * 4                        // (o, d) handed over by the previous CTA
+         + 16 * 4 + 16;                                      // row sums, mbarrier
+}
+
+__device__ __forceinline__ void mbarrier_init(void* bar, int count) {
+  asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;\n"
+               "fence.mbarrier_init.release.cluster;" ::"r"(smem_u32(bar)), "r"(count));
+}
+// Arrive at the mbarrier at `bar`'s offset in the shared memory of the cluster's CTA `rank`.
+__device__ __forceinline__ void mbarrier_arrive_remote(void* bar, int rank) {
+  asm volatile("{\n"
+               ".reg .b32 remAddr32;\n"
+               "mapa.shared::cluster.u32 remAddr32, %0, %1;\n"
+               "mbarrier.arrive.shared::cluster.b64 _, [remAddr32];\n"
+               "}" ::"r"(smem_u32(bar)), "r"(rank));
+}
+__device__ __forceinline__ void mbarrier_wait(void* bar, int phase) {
+  asm volatile("{\n"
+               ".reg .pred P1;\n"
+               "LAB_WAIT:\n"
+               "mbarrier.try_wait.parity.shared::cta.b64 P1, [%0], %1;\n"
+               "@P1 bra DONE;\n"
+               "bra LAB_WAIT;\n"
+               "DONE:\n"
+               "}" ::"r"(smem_u32(bar)), "r"(phase));
+}

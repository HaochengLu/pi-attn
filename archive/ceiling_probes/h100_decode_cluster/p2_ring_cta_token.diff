+  const int group = num_qo_heads / num_kv_heads;
+  const int32_t* pages = request_pages(kv_page_indices, kv_page_indptr, table_stride, b);
+  if (c > c_last) {  // no tile: nobody writes to this CTA
+    cluster.sync();
+    return;
+  }
+
+  // Everything this CTA reads is issued now: K of its tiles (first group), then V.
+  int64_t rows[kTPC];
+#pragma unroll
+  for (int lt = 0; lt < kTPC; ++lt) {
+    rows[lt] = -1;
+    if (c * kTPC + lt < nt) {
+      rows[lt] = tile_row(pages, page_size, page_shift, t_begin + c * kTPC + lt, kv_len, num_kv_heads, kvh, tid);

+                    const int32_t* __restrict__ kv_page_indices, int64_t table_stride,
+                    const int32_t* __restrict__ kv_lens, float* __restrict__ ws_o, float2* __restrict__ ws_ml,
+                    int* __restrict__ counters, __nv_bfloat16* __restrict__ out, int max_groups,
+                    int num_qo_heads, int num_kv_heads, int page_size, int page_shift, float scale_log2,
+                    bool group_fastest) {
+  static_assert(N == 2 || N == 4 || N == 8 || N == 16, "cluster of 2, 4, 8 or 16 CTAs");
+  static_assert(kTileNS == kDecodeWarps && kNTilesO % kDecodeWarps == 0, "decode_kernel's warp split");
+  constexpr int kTPC = kGroupTiles / N;  // key tiles per CTA
+  constexpr int kON = kNTilesO / kDecodeWarps, kPStride = kTile + 8, kPTile = 16 * kPStride;
+  constexpr int kTileElems = kTile * kHeadDim;
+  extern __shared__ __align__(16) __nv_bfloat16 smem[];
+  __nv_bfloat16* sK = smem;                    // [kTPC][kTile][128], swz per tile
+  __nv_bfloat16* sV = sK + kTPC * kTileElems;  // the same
+  __nv_bfloat16* sP = sV + kTPC * kTileElems;  // [kTPC][16 rows][kPStride]
+  float* sMax = reinterpret_cast<float*>(sP + kTPC * kPTile);  // [16 tiles][warps][16 rows]
+  float* sTokO = sMax + kGroupTiles * kDecodeWarps * 16;       // [16 rows][128]
+  float* sTokD = sTokO + 16 * kHeadDim;                        // [16 rows]
+  float* sL = sTokD + 16;                                      // [16 rows]
+  void* sBar = sL + 16;                                        // mbarrier: (o, d) has arrived
+  cooperative_groups::cluster_group cluster = cooperative_groups::this_cluster();
+  const int c = blockIdx.x % N, xi = blockIdx.x / N;  // rank in the cluster, decode_grid's x
+  const int kvh = group_fastest ? blockIdx.y : xi, b = group_fastest ? 0 : blockIdx.y;
+  const int fg = group_fastest ? xi : blockIdx.z;
+  const int kv_len = kv_lens[b], pos = kv_len - 1;
+  const int n_tiles = (kv_len + kTile - 1) / kTile;
+  const int t_begin = fg * kGroupTiles;
+  if (t_begin >= n_tiles) return;  // the whole cluster returns
+  const int nt = min(n_tiles - t_begin, kGroupTiles);  // tiles of this group

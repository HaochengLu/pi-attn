+        for (int r = 0; r < 2; ++r) {
+          ls[r] = add(ls[r], __shfl_xor_sync(0xffffffffu, ls[r], 1));
+          ls[r] = add(ls[r], __shfl_xor_sync(0xffffffffu, ls[r], 2));

+// ---------------------------------------------------------------------------------------------------------
+// Decode on Hopper: one fold group on a thread-block cluster of N CTAs (N = 2, 4, 8), each on its own SM.
+//
+// decode_kernel streams a group's 256 KB of K and V through one SM, and that is its whole time at small
+// batch (archive/ceiling_probes/h100_decode). The contract serialises very little of a group:
+//   S of a key          depends on that key only                      -> split by key tile over the CTAs
+//   m_t                 a prefix max of exact tile maxima             -> any order
+//   scale_t, P_t        functions of S and m_t, elementwise
+//   d_t                 fma(d_(t-1), scale_t, row sum of P_t)         -> a scalar chain
+//   o_t[d]              fma(o_(t-1)[d], scale_t, +0) + P_t V_t[:, d]  -> a chain per head dim d
+// So CTA c of the cluster loads the K of key tiles [16 c / N, 16 (c + 1) / N) and, for all 512 keys, only the
+// head dims [128 c / N, 128 (c + 1) / N) of V: 256 / N KB per SM, all issued at once. Three phases, separated
+// by cluster barriers; the tile maxima and P travel through distributed shared memory:
+//   1. S of the CTA's own tiles (decode_kernel's mma sequence), tile maxima written to every CTA;
+//   2. the prefix max, scale_t for every tile, P of the own tiles written to every CTA;
+//   3. each CTA runs, for its head dims, the chain of decode_kernel over the tiles in ascending order (fma
+//      rescale, then the two key k-steps), and the d chain from P in online_step's order.
+// Every element therefore runs decode_kernel's instruction sequence on the same operands: the bits are those
+// of decode_kernel. The partial / arrival-counter / fold protocol is decode_kernel's, per 32-dim quarter.
+template <int N>
+constexpr int decode90_smem_bytes() {
+  return 2 * (kGroupKeys / N) * kHeadDim * 2                 // K tiles, V dim slice
+         + kGroupTiles * 16 * (kTile + 8) * 2                 // P of every tile
+         + kGroupTiles * (kDecodeWarps + 1) * 16 * 4 + 16 * 4;  // tile maxima per warp, scales, row sums
+}
+
+__device__ __forceinline__ void ldmatrix_x2_trans(uint32_t (&r)[2], const void* p) {
+  asm volatile("ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16 {%0,%1}, [%2];"
+               : "=r"(r[0]), "=r"(r[1])
+               : "r"(smem_u32(p)));
+}
+
+template <int N>
+__global__ void __launch_bounds__(kDecodeWarps * 32)
+    decode90_kernel(const __nv_bfloat16* __restrict__ q, const __nv_bfloat16* __restrict__ k_cache,
+                    const __nv_bfloat16* __restrict__ v_cache, const int32_t* __restrict__ kv_page_indptr,
+                    const int32_t* __restrict__ kv_page_indices, int64_t table_stride,
+                    const int32_t* __restrict__ kv_lens, float* __restrict__ ws_o, float2* __restrict__ ws_ml,
+                    int* __restrict__ counters, __nv_bfloat16* __restrict__ out, int max_groups,
+                    int num_qo_heads, int num_kv_heads, int page_size, int page_shift, float scale_log2,
+                    bool group_fastest) {
+  static_assert(N == 2 || N == 4 || N == 8, "cluster of 2, 4 or 8 CTAs");
+  static_assert(kTileNS == kDecodeWarps && kGroupTiles == 16 && kNTilesO == 16, "decode_kernel's warp split");
+  constexpr int kTPC = kGroupTiles / N;         // key tiles of K per CTA
+  constexpr int kCH = kNTilesO / N;             // 8-dim chunks (O n-tiles) of V per CTA
+  constexpr int kOW = kCH < 4 ? kCH : 4;        // warps that run the O chain
+  constexpr int kON = kCH / kOW;                // O n-tiles per such warp (1 or 2)
+  constexpr int kVSh = kCH == 2 ? 2 : kCH == 4 ? 1 : 0;  // V swizzle: 8 consecutive keys, 8 distinct 16-byte banks
+  constexpr int kDW = kDecodeWarps - 1;         // the warp that runs the d chain
+  constexpr int kPStride = kTile + 8, kPTile = 16 * kPStride;
+  extern __shared__ __align__(16) __nv_bfloat16 smem[];
+  __nv_bfloat16* sK = smem;                                  // [kTPC][kTile][128], swz per tile
+  __nv_bfloat16* sV = sK + kTPC * kTile * kHeadDim;          // [512 keys][kCH chunks]
+  __nv_bfloat16* sP = sV + kGroupKeys * kCH * 8;             // [16 tiles][16 rows][kPStride]
+  float* sMax = reinterpret_cast<float*>(sP + kGroupTiles * kPTile);  // [16 tiles][warps][16 rows]
+  float* sScale = sMax + kGroupTiles * kDecodeWarps * 16;    // [16 tiles][16 rows]
+  float* sL = sScale + kGroupTiles * 16;                     // [16 rows]
+  cooperative_groups::cluster_group cluster = cooperative_groups::this_cluster();
+  const int c = blockIdx.x % N, xi = blockIdx.x / N;         // rank in the cluster, decode_grid's x
+  const int kvh = group_fastest ? blockIdx.y : xi, b = group_fastest ? 0 : blockIdx.y;
+  const int fg = group_fastest ? xi : blockIdx.z;
+  const int kv_len = kv_lens[b], pos = kv_len - 1;
+  const int n_tiles = (kv_len + kTile - 1) / kTile;
+  const int t_begin = fg * kGroupTiles;
+  if (t_begin >= n_tiles) return;  // the whole cluster returns
+  const int nt = min(n_tiles - t_begin, kGroupTiles);
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const int g = lane >> 2, t4 = lane & 3, mat = lane >> 3, r8 = lane & 7;
+  const int group = num_qo_heads / num_kv_heads;
+  const int32_t* pages = request_pages(kv_page_indices, kv_page_indptr, table_stride, b);
+  auto v_ptr = [&](int key, int chunk) -> __nv_bfloat16* {
+    return sV + key * (kCH * 8) + ((chunk ^ ((key >> kVSh) & (kCH - 1))) << 3);
+  };
+
+  // Everything this CTA reads is issued now: K of its tiles (first group), then its V slice.
+#pragma unroll
+  for (int lt = 0; lt < kTPC; ++lt) {
+    const int tl = c * kTPC + lt;
+    if (tl < nt)
+      issue_tile(sK + lt * kTile * kHeadDim, k_cache,
+                 tile_row(pages, page_size, page_shift, t_begin + tl, kv_len, num_kv_heads, kvh, tid), tid);
+  }
+  cp_async_commit();
+  if ((tid & 3) < kCH) {
+#pragma unroll
+    for (int tl = 0; tl < kGroupTiles; ++tl) {
+      if (tl < nt) {
+        const int64_t row = tile_row(pages, page_size, page_shift, t_begin + tl, kv_len, num_kv_heads, kvh, tid);
+        const __nv_bfloat16* src = v_cache + (row >= 0 ? row : 0) + c * (kCH * 8);
+        const int key = tl * kTile + (tid >> 2);
+#pragma unroll
+        for (int ch = tid & 3; ch < kCH; ch += 4) cp_async16(v_ptr(key, ch), src + ch * 8, row >= 0 ? 16 : 0);
+      }
+    }

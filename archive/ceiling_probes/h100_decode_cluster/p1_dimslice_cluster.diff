+      for (int ks = 0; ks < kKStepsQK; ++ks) {
+        uint32_t bk[4];
+        ldmatrix_x4(bk, sK + lt * kTile * kHeadDim + swz(warp * 8 + r8, ks * 2 + (mat & 1)));
+        mma_bf16(s[lt], qf.a[ks], bk[0], bk[1]);
+      }
+      float mx[2] = {-INFINITY, -INFINITY};
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const int row = g + (i >> 1) * 8, key = (t_begin + tl) * kTile + warp * 8 + t4 * 2 + (i & 1);
+        s[lt][i] = (row < group && key <= pos) ? mul(s[lt][i], scale_log2) : -INFINITY;
+        mx[i >> 1] = fmaxf(mx[i >> 1], s[lt][i]);
+      }
+#pragma unroll
+      for (int r = 0; r < 2; ++r) {
+        mx[r] = fmaxf(mx[r], __shfl_xor_sync(0xffffffffu, mx[r], 1));
+        mx[r] = fmaxf(mx[r], __shfl_xor_sync(0xffffffffu, mx[r], 2));
+      }
+      if (t4 == 0) {
+#pragma unroll
+        for (int j = 0; j < N; ++j) {
+          float* rm = cluster.map_shared_rank(sMax, j) + (tl * kDecodeWarps + warp) * 16;
+          if (g < group) rm[g] = mx[0];
+          if (g + 8 < group) rm[g + 8] = mx[1];
+        }
+      }
+    }
+  }
+  cluster.sync();
+
+  // Phase 2: running max and scale of every tile; P of the own tiles to every CTA.
+  float M[2] = {-INFINITY, -INFINITY};
+  if (g < group) {
+#pragma unroll
+    for (int tl = 0; tl < kGroupTiles; ++tl) {
+      if (tl < nt) {
+        float mm[2] = {0.f, 0.f}, scale[2] = {0.f, 0.f};
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+          if (g + r * 8 < group) {
+            float tmax = -INFINITY;
+#pragma unroll
+            for (int w = 0; w < kDecodeWarps; ++w) tmax = fmaxf(tmax, sMax[(tl * kDecodeWarps + w) * 16 + g + r * 8]);
+            const float mn = fmaxf(M[r], tmax);
+            mm[r] = mn == -INFINITY ? 0.f : mn;
+            scale[r] = ex2(sub(M[r], mm[r]));
+            M[r] = mn;
+          }
+        }
+        if (warp == 0 && t4 == 0) {
+          sScale[tl * 16 + g] = scale[0];
+          if (g + 8 < group) sScale[tl * 16 + g + 8] = scale[1];
+        }
+        if (tl / kTPC == c) {
+          float p[4];
+#pragma unroll
+          for (int i = 0; i < 4; ++i) p[i] = round_bf16(ex2(sub(s[tl % kTPC][i], mm[i >> 1])));
+          const uint32_t p0 = pack_bf16(p[0], p[1]), p1 = pack_bf16(p[2], p[3]);
+          const int key = warp * 8 + t4 * 2;
+#pragma unroll
+          for (int j = 0; j < N; ++j) {
+            __nv_bfloat16* rp = cluster.map_shared_rank(sP, j) + tl * kPTile;
+            *reinterpret_cast<uint32_t*>(rp + g * kPStride + key) = p0;
+            if (g + 8 < group) *reinterpret_cast<uint32_t*>(rp + (g + 8) * kPStride + key) = p1;
+          }
+        }
+      }
+    }
+  }
+  cp_async_wait<0>();  // this thread's V copies
+  cluster.sync();
+
+  // Phase 3: the O chain of this CTA's head dims and (warp kDW) the d chain, tiles ascending. Rows >= group
+  // read unwritten P and scales; their results are never written out.
+  float D = 0.f, Dh = 0.f;
+  float O[kON][4];
+#pragma unroll
+  for (int n = 0; n < kON; ++n) O[n][0] = O[n][1] = O[n][2] = O[n][3] = 0.f;
+  if (warp < kOW || warp == kDW) {
+    for (int tl = 0; tl < nt; ++tl) {

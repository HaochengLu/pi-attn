+  const int qd = c / kArr * kQW + warp;
+  int last = 0;
+  if (lane == 0) {
+    int* cnt = counters + ((int64_t)b * num_kv_heads + kvh) * kDecodeWarps + qd;
+    last = atomicAdd(cnt, 1) == n_groups * kArr - 1;
+    if (last) *cnt = 0;  // ready for the next launch
+  }
+  if (!__shfl_sync(0xffffffffu, last, 0)) return;
+  __threadfence();
+  constexpr int kFoldAhead = 8;
+  for (int p = lane; p < group * 8; p += 32) {
+    const int h = p >> 3, d0 = qd * 32 + (p & 7) * 4;
+    float Mf = -INFINITY, L = 0.f, Of[4] = {0.f, 0.f, 0.f, 0.f};
+    const int64_t slot_h = (int64_t)b * max_groups * num_qo_heads + head0 + h;
+    for (int c0 = 0; c0 < n_groups; c0 += kFoldAhead) {
+      float2 ml[kFoldAhead];
+      float4 oc[kFoldAhead];
+#pragma unroll
+      for (int i = 0; i < kFoldAhead; ++i) {
+        if (c0 + i >= n_groups) break;
+        const int64_t slot = slot_h + (int64_t)(c0 + i) * num_qo_heads;
+        ml[i] = __ldcg(ws_ml + slot * kDecodeWarps + qd);
+        oc[i] = __ldcg(reinterpret_cast<const float4*>(ws_o + slot * kHeadDim + d0));
+      }
+#pragma unroll
+      for (int i = 0; i < kFoldAhead; ++i) {
+        if (c0 + i >= n_groups) break;
+        const FoldScalars f = fold_scalars(Mf, L, ml[i].x, ml[i].y);
+        Of[0] = fold_elem(Of[0], oc[i].x, f);
+        Of[1] = fold_elem(Of[1], oc[i].y, f);
+        Of[2] = fold_elem(Of[2], oc[i].z, f);
+        Of[3] = fold_elem(Of[3], oc[i].w, f);
+      }
+    }
+    __nv_bfloat16* o = out + ((int64_t)b * num_qo_heads + head0 + h) * kHeadDim + d0;
+    reinterpret_cast<__nv_bfloat162*>(o)[0] = __halves2bfloat162(finish(Of[0], L), finish(Of[1], L));
+    reinterpret_cast<__nv_bfloat162*>(o)[1] = __halves2bfloat162(finish(Of[2], L), finish(Of[3], L));
+  }
+}
+
+// Launch decode90_kernel<n> on decode_grid with x scaled by the cluster size (cluster = n CTAs along x).
+inline cudaError_t decode90_launch(int n, cudaStream_t stream, const __nv_bfloat16* q, const __nv_bfloat16* k_cache,
+                                   const __nv_bfloat16* v_cache, const int32_t* kv_page_indptr,
+                                   const int32_t* kv_page_indices, int64_t table_stride, const int32_t* kv_lens,
+                                   float* ws_o, float2* ws_ml, int* counters, __nv_bfloat16* out, int max_groups,
+                                   int batch, int num_qo_heads, int num_kv_heads, int page_size, int page_shift,
+                                   float scale_log2) {
+  auto go = [&](auto kernel, int smem) -> cudaError_t {
+    const cudaError_t err = cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, smem);
+    if (err != cudaSuccess) return err;
+    cudaLaunchConfig_t cfg = {};
+    cfg.gridDim = decode_grid(max_groups, num_kv_heads, batch);
+    cfg.gridDim.x *= n;
+    cfg.blockDim = dim3(kDecodeWarps * 32);
+    cfg.dynamicSmemBytes = smem;
+    cfg.stream = stream;
+    cudaLaunchAttribute attr[1];
+    attr[0].id = cudaLaunchAttributeClusterDimension;
+    attr[0].val.clusterDim.x = n;
+    attr[0].val.clusterDim.y = 1;
+    attr[0].val.clusterDim.z = 1;
+    cfg.attrs = attr;
+    cfg.numAttrs = 1;
+    return cudaLaunchKernelEx(&cfg, kernel, q, k_cache, v_cache, kv_page_indptr, kv_page_indices, table_stride,
+                              kv_lens, ws_o, ws_ml, counters, out, max_groups, num_qo_heads, num_kv_heads, page_size,
+                              page_shift, scale_log2, decode_group_fastest(batch));
+  };
+  switch (n) {
+    case 2: return go(decode90_kernel<2>, decode90_smem_bytes<2>());
+    case 4: return go(decode90_kernel<4>, decode90_smem_bytes<4>());
+    case 8: return go(decode90_kernel<8>, decode90_smem_bytes<8>());
+  }
+  return cudaErrorInvalidValue;
+}

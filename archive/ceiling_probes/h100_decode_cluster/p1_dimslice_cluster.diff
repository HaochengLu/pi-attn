+          for (int i = 0; i < 4; ++i) O[n][i] = __fmaf_rn(O[n][i], scale[i >> 1], 0.f);
+#pragma unroll
+        for (int j = 0; j < kTileKS; ++j) {
+          const int key = tl * kTile + j * 16 + (mat & 1) * 8 + r8;
+          if constexpr (kON == 1) {
+            uint32_t bv[2];
+            ldmatrix_x2_trans(bv, v_ptr(key, warp));
+            mma_bf16(O[0], pa[j], bv[0], bv[1]);
+          } else {
+            uint32_t bv[4];
+            ldmatrix_x4_trans(bv, v_ptr(key, warp * kON + (mat >> 1)));
+            mma_bf16(O[0], pa[j], bv[0], bv[1]);
+            mma_bf16(O[kON - 1], pa[j], bv[2], bv[3]);

+// ---------------------------------------------------------------------------------------------------------
+// Decode on Hopper: decode_kernel's program with a fold group's K and V in flight at once, on one CTA (N = 1)
+// or on a thread-block cluster of N = 2 or 4 CTAs on different SMs.
+//
+// decode_kernel keeps one K and one V tile in flight, and that latency is its time: 256 KB per fold group at
+// 0.85 us per tile, from DRAM or from L2 alike. A CTA takes the same bytes in 6.6 us when 16 tile loads are in
+// flight (archive/ceiling_probes/h100_decode_cluster), and several CTAs take them proportionally faster. The
+// contract serialises little of a group: S of a key depends on that key only, the running max is a prefix max
+// of exact tile maxima, scale_t and P_t are elementwise functions of S and the max, and only d_t and o_t are
+// chains. So CTA c of the cluster owns the key tiles [c T, (c + 1) T) of the group (T = ceil(tiles / N)):
+//   A. it issues the K of all its tiles and as much V as shared memory holds (N = 1: 8 of 16 tiles; the rest
+//      go into K slots as S frees them), one cp.async group per tile;
+//   B. S of its tiles in order as their K lands (decode_kernel's mma sequence), exact maxima per warp;
+//   C. (m, d, o) from CTA c - 1 through its shared memory, an mbarrier per warp signalling the hand-off
+//      (about 0.45 us); then the running max, the scales and P of its tiles, as decode_kernel forms them;
+//   D. decode_kernel's d and o steps over its tiles in order as their V lands; (m, d, o) to CTA c + 1.
+// The CTA of the group's last tile writes the output or the group partial exactly as decode_kernel does.
+// Every element runs decode_kernel's instruction sequence on the same operands: the same bits.
+template <int N>
+constexpr int decode90_smem_bytes() {
+  return (N == 1 ? 24 : 2 * (kGroupTiles / N)) * kTile * kHeadDim * 2  // K and V tile slots
+         + (kGroupTiles / N) * 16 * (kTile + 8) * 2                     // P of the CTA's tiles
+         + (kGroupTiles / N) * (kDecodeWarps + 1) * 16 * 4              // per-warp maxima and scales of its tiles
+         + 16 * 4                                                       // row sums
+         + (N > 1 ? (16 * kHeadDim + (kDecodeWarps + 1) * 16) * 4 + kDecodeWarps * 8 : 0);  // hand-off, mbarriers
+}
+
+__device__ __forceinline__ void mbarrier_init(void* bar, int count) {
+  asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;\n"
+               "fence.mbarrier_init.release.cluster;" ::"r"(smem_u32(bar)), "r"(count));
+}
+// Arrive at the mbarrier at `bar`'s offset in the shared memory of the cluster's CTA `rank`; releases this
+// thread's earlier writes to that CTA's shared memory to the waiter (cluster scope).
+__device__ __forceinline__ void mbarrier_arrive_remote(void* bar, int rank) {
+  asm volatile("{\n"
+               ".reg .b32 remAddr32;\n"
+               "mapa.shared::cluster.u32 remAddr32, %0, %1;\n"
+               "mbarrier.arrive.release.cluster.shared::cluster.b64 _, [remAddr32];\n"
+               "}" ::"r"(smem_u32(bar)), "r"(rank));
+}
+__device__ __forceinline__ void mbarrier_wait(void* bar, int phase) {
+  asm volatile("{\n"
+               ".reg .pred P1;\n"
+               "LAB_WAIT:\n"
+               "mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 P1, [%0], %1;\n"
+               "@P1 bra DONE;\n"
+               "bra LAB_WAIT;\n"
+               "DONE:\n"
+               "}" ::"r"(smem_u32(bar)), "r"(phase));
+}

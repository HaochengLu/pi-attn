+// PROBE (wrong bits): the second half of a 64-key step. A 64-key step takes one row max, one scale, one rescale
+// of o and one cross-lane sum per 64 keys; this runs a 32-key tile with the max of its own lane only folded in,
+// no scale, no rescale and no cross-lane sum, i.e. what the odd tile of a pair would still cost.
+__device__ __forceinline__ void online_step_light(OnlineState& st, float (&v)[kTileNS][4], uint32_t (&pa)[kTileKS][4]) {
+  float mx[2] = {-INFINITY, -INFINITY};
+#pragma unroll
+  for (int n = 0; n < kTileNS; ++n)
+#pragma unroll
+    for (int i = 0; i < 4; ++i) mx[i >> 1] = fmaxf(mx[i >> 1], v[n][i]);
+  float mm[2];
+#pragma unroll
+  for (int r = 0; r < 2; ++r) {
+    st.m[r] = fmaxf(st.m[r], mx[r]);
+    mm[r] = st.m[r] == -INFINITY ? 0.f : st.m[r];
+  }
+  float ls[2] = {0.f, 0.f};
+#pragma unroll
+  for (int n = 0; n < kTileNS; ++n) {
+    float e[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) e[i] = ex2(sub(v[n][i], mm[i >> 1]));
+    const uint32_t w0 = pack_bf16(e[0], e[1]), w1 = pack_bf16(e[2], e[3]);
+    ls[0] = add(ls[0], bf16_lo(w0));
+    ls[0] = add(ls[0], bf16_hi(w0));
+    ls[1] = add(ls[1], bf16_lo(w1));
+    ls[1] = add(ls[1], bf16_hi(w1));
+    pa[n >> 1][(n & 1) * 2 + 0] = w0;
+    pa[n >> 1][(n & 1) * 2 + 1] = w1;
+  }
+  st.d[0] = add(st.d[0], ls[0]);
+  st.d[1] = add(st.d[1], ls[1]);
+}

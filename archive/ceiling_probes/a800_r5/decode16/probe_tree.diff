+// single request: the group fastest; else the kv head fastest and the group slowest), then the helpers.
+__global__ void __launch_bounds__(kD16Warps * 32)
+    decode16_kernel(const __nv_bfloat16* __restrict__ q, const __nv_bfloat16* __restrict__ k_cache,
+                    const __nv_bfloat16* __restrict__ v_cache, const int32_t* __restrict__ kv_page_indptr,
+                    const int32_t* __restrict__ kv_page_indices, int64_t table_stride,
+                    const int32_t* __restrict__ kv_lens, float* __restrict__ ws_o, float2* __restrict__ ws_ml,
+                    int* __restrict__ counters, __nv_bfloat16* __restrict__ out, int max_groups,
+                    int num_qo_heads, int num_kv_heads, int page_size, int page_shift, float scale_log2,
+                    int batch, int slots, int helpers) {
+  const int cols = batch * num_kv_heads, c = blockIdx.x;
+  const bool helper = c >= cols * slots;
+  const int helped_cols = min(cols, 2 * helpers);  // columns [0, helped_cols) hand their last group to a helper
+  // Column CTA: slot j of column col. Helper: the columns c - cols * slots and that + helpers.
+  const int j = helper ? 0 : batch == 1 ? c % slots : c / cols;
+  int col = helper ? c - cols * slots : batch == 1 ? c / slots : c % cols;
+  for (int i = 0;; ++i) {
+    if (helper && col >= helped_cols) break;
+    const int b = col / num_kv_heads, kvh = col % num_kv_heads;
+    const int kv_len = kv_lens[b];

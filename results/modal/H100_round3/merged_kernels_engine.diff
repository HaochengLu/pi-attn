+          float& to = tot[(n * 4 + 2 * r + e) * 128];
+          folded[e] = fold_elem(stored ? to : 0.f, o[n][2 * r + e], f);
+          if (!last) to = folded[e];
+        }
+        if (write) {
+          __nv_bfloat162 ob;
+          ob.x = finish(folded[0], tot_d[r]);
+          ob.y = finish(folded[1], tot_d[r]);
+          *reinterpret_cast<__nv_bfloat162*>(dst + n * 8 + t4 * 2) = ob;
+        }
+      }
